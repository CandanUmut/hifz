what"},{"ar":"ٱلْقَارِعَةُ","translit":"l-qāriʿatu","en":"(is) the Striking Calamity"}],"audio":{"from":4620,"to":10210,"wordTimings":[[0,4535,6724],[1,6725,8175],[2,8175,8295],[3,8295,10000]]}},{"index":3,"ref":"101:4","content":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","translations":{"elmalili-sadelestirilmis":"O gün insanlar çırpınıp yayılan pervaneler gibi olacak","diyanet-isleri":"O gün insanlar, ateş etrafında çırpınıp dökülen pervaneye dönecekler","clear-quran":"˹It is˺ the Day people will be like scattered moths","pickthall":"A day wherein mankind will be as thickly-scattered moths"},"transliterations":{"easy":"Yauma ya koonun naasu kal farashil mabthooth","scholarly":"Yawma Yakūnu An-Nāsu Kālfarāshi Al-Mabthūthi","aligned":"yawma yakūnu l-nāsu kal-farāshi l-mabthūthi"},"words":[{"ar":"يَوْمَ","translit":"yawma","en":"(The) Day"},{"ar":"يَكُونُ","translit":"yakūnu","en":"will be"},{"ar":"ٱلنَّاسُ","translit":"l-nāsu","en":"the mankind"},{"ar":"كَٱلْفَرَاشِ","translit":"kal-farāshi","en":"like moths"},{"ar":"ٱلْمَبْثُوثِ","translit":"l-mabthūthi","en":"scattered"}],"audio":{"from":10210,"to":17990,"wordTimings":[[0,10085,10765],[1,10765,11665],[2,11665,13235],[3,13235,14555],[4,14555,17440]]}},{"index":4,"ref":"101:5","content":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","translations":{"elmalili-sadelestirilmis":"Dağlar da didilmiş renkli yünler gibi atılacaktır","diyanet-isleri":"Dağlar, atılmış renkli yüne benzeyecekler","clear-quran":"and the mountains will be like carded wool","pickthall":"And the mountains will become as carded wool"},"transliterations":{"easy":"Wa ta koonul jibalu kal 'ihnil manfoosh","scholarly":"Wa Takūnu Al-Jibālu Kāl`ihni Al-Manfūshi","aligned":"watakūnu l-jibālu kal-ʿih'ni l-manfūshi"},"words":[{"ar":"وَتَكُونُ","translit":"watakūnu","en":"And will be"},{"ar":"ٱلْجِبَالُ","translit":"l-jibālu","en":"the mountains"},{"ar":"كَٱلْعِهْنِ","translit":"kal-ʿih'ni","en":"like wool"},{"ar":"ٱلْمَنفُوشِ","translit":"l-manfūsh